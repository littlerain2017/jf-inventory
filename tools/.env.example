# 微信读书 Cookie（必填）
# 获取方法：
#   1. 浏览器打开 https://weread.qq.com 并登录
#   2. 按 F12 打开开发者工具 → Application → Cookies → weread.qq.com
#   3. 找到 wr_skey，复制其值粘贴到下方
WEREAD_SKEY=your_wr_skey_here

# 可选：wr_vid（部分接口需要）
# WEREAD_VID=your_vid_here

# 可选：完整 Cookie 字符串（如果单独 wr_skey 不够用，可粘贴整行 Cookie）
# WEREAD_COOKIE=wr_skey=xxx; wr_name=xxx; vid=xxx; ...

# Anthropic API Key（必填）
# 从 https://console.anthropic.com 获取
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Notion 集成（使用 --notion 参数时需要填写）────────────────────────────────

# Notion Integration Token
# 步骤：https://www.notion.so/my-integrations → New integration → 复制 secret_xxx
NOTION_API_KEY=secret_your-integration-token

# 目标 Notion 页面 ID（生词表将创建为该页面的子页面）
# 打开 Notion 目标页面，URL 末尾 32 位字符串即为 ID
# 例如 https://notion.so/MyBook-Notes-abc123def456... → abc123def456...
# 注意：需在该页面右上角 ··· → Connections 中添加你的 Integration
NOTION_PAGE_ID=your-32-char-page-id-here
