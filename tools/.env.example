# 微信读书 Cookie（必填）
# 获取方法：
#   1. 浏览器打开 https://weread.qq.com 并登录
#   2. 按 F12 打开开发者工具 → Application → Cookies → weread.qq.com
#   3. 找到 wr_skey，复制其值粘贴到下方
WEREAD_SKEY=your_wr_skey_here

# 可选：wr_vid（部分接口需要）
# WEREAD_VID=your_vid_here

# 可选：完整 Cookie 字符串（如果单独 wr_skey 不够用，可粘贴整行 Cookie）
# WEREAD_COOKIE=wr_skey=xxx; wr_name=xxx; vid=xxx; ...

# Anthropic API Key（必填）
# 从 https://console.anthropic.com 获取
ANTHROPIC_API_KEY=sk-ant-your-key-here
